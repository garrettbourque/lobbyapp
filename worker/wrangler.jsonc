{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lobbyapp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "observability": { "enabled": true },

  "vars": {
    // Only the kiosk site may call this Worker (comma-separated).
    "ALLOWED_ORIGINS": "https://lobbyapp.app,https://www.lobbyapp.app",
    // Sender address on the Cloudflare domain.
    "FROM_ADDRESS": "kiosk@lobbyapp.app",
    "FROM_NAME": "Lobby Kiosk"
  },

  // No restriction attribute: can only send to destination addresses verified
  // in Email Routing, so clinicians and facility admins each confirm their address once.
  "send_email": [{ "name": "EMAIL" }],

  // Facilities, kiosks, clinicians and the check-in log (schema.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobbyapp",
      "database_id": "cff821b4-79bb-4cfc-b43c-ba1b174ee1f3"
    }
  ],

  "ratelimits": [
    {
      "name": "NOTIFY_LIMITER",
      "namespace_id": "1001",
      // At most 3 emails per clinician per minute.
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
